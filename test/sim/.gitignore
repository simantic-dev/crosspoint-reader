# Run artefacts: the tests execute in this directory, so the simulator drops
# its output here. Regenerated by every run; none of it belongs in the repo.
hidrun-epd-*.pbm
hidrun-epd-*.pgm
scanwatch*.log
*.pytest_cache/

# Build artefacts the bench needs but does not own -- see the module docstring
# in test_ble_page_turner.py for how to produce them. The tests skip when they
# are absent, so a bare checkout stays green.
sdcard.img

# The simulator payload embeds Espressif's proprietary ESP32-C3 mask ROM, which
# is not redistributable. Build it locally with build_payload.sh instead.
../payloads/
output.txt

# Generated by simantic.Sim at run time
.sim-*.repl
sdcard*.img
trace-toggle.yaml
trace-toggle.log
trace-reopen-hid.yaml
trace-reopen-hid.log
