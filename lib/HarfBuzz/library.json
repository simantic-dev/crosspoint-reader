{
  "name": "HarfBuzz",
  "version": "14.5.0",
  "description": "HarfBuzz text shaping engine, vendored as the single-TU amalgamation (harfbuzz.cc)",
  "build": {
    "srcFilter": ["+<harfbuzz.cc>"],
    "flags": [
      "-DHB_TINY",
      "-DHB_NO_MT",
      "-DHB_LEAN",
      "-DHB_NO_OT_FONT_GLYPH_NAMES",
      "-DHB_NO_BUFFER_SERIALIZE",
      "-DHB_NO_BUFFER_VERIFY",
      "-DHB_NO_PAINT",
      "-DHB_NO_DRAW",
      "-DHB_NO_META",
      "-DHB_NO_STYLE",
      "-DHB_NO_VAR",
      "-DHB_NO_AAT",
      "-DHB_NO_LAYOUT_FEATURE_PARAMS",
      "-DHB_NO_LAYOUT_COLLECT_GLYPHS",
      "-DHB_NO_LAYOUT_UNUSED",
      "-DHB_NO_OT_SHAPER_ARABIC",
      "-DHB_NO_OT_SHAPER_HEBREW",
      "-DHB_NO_OT_SHAPER_THAI",
      "-DHB_NO_OT_SHAPER_KHMER",
      "-DHB_NO_OT_SHAPER_MYANMAR",
      "-DHB_NO_OT_SHAPER_HANGUL",
      "-DHB_NO_OT_SHAPER_USE"
    ],
    "includeDir": "src"
  }
}
